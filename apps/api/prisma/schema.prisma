generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  CREATED
  PAID
  PREPARING
  READY
  DELIVERED
  CANCELED
}

enum OrderMode {
  DINE_IN
  TAKEAWAY
}

enum PayMethod {
  PIX
  CARD
  /// Pago no caixa; a equipe confirma o recebimento.
  CASH
}

enum Role {
  ADMIN
  KITCHEN
  CASHIER
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role
  /// Incrementa ao trocar a senha: invalida todos os JWTs emitidos antes.
  tokenVersion Int      @default(0)
  /// Usuário desativado não entra nem mantém sessão, mas continua no histórico.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  resetTokens  PasswordResetToken[]
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 do token enviado ao usuário; o token em si nunca é guardado.
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Contador da senha diária: uma linha por dia de operação (AAAA-MM-DD, fuso de São Paulo).
model DailyCounter {
  date String @id
  last Int    @default(0)
}

model Category {
  id       String    @id
  label    String
  emoji    String
  position Int       @default(0)
  products Product[]
}

model Product {
  id          String   @id
  name        String
  description String
  priceCents  Int
  emoji       String
  available   Boolean  @default(true)
  /// "Excluído": some do cardápio e não pode ser vendido, mas continua no histórico de pedidos.
  archived    Boolean  @default(false)
  stock       Int?
  removable   String[]
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  extras      Extra[]
  orderItems  OrderItem[]
}

model Extra {
  id         String  @id
  name       String
  priceCents Int
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id         String      @id @default(uuid())
  number     Int         @unique @default(autoincrement())
  /// Senha exibida ao cliente: recomeça em 1 a cada dia (fuso de São Paulo). `number` é o id interno, sequencial para sempre.
  ticket     Int         @default(0)
  status     OrderStatus @default(CREATED)
  mode       OrderMode
  totalCents Int
  discountCents Int       @default(0)
  couponCode String?
  clientRef  String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  items      OrderItem[]
  payment    Payment?
  history    OrderEvent[]

  @@index([clientRef])
}

model OrderItem {
  id             String   @id @default(uuid())
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  qty            Int
  unitPriceCents Int
  extras         Json     @default("[]")
  removed        String[]
}

model Payment {
  id          String    @id @default(uuid())
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method      PayMethod
  amountCents Int
  idempotencyKey String? @unique
  /// Id da cobrança no provedor Pix (ex.: id do pagamento no Mercado Pago).
  providerRef String?  @unique
  status      PaymentStatus @default(PAID)
  txid        String?   @unique
  pixPayload  String?
  expiresAt   DateTime?
  paidAt      DateTime?
  /// Quem confirmou o recebimento (pagamento no caixa).
  confirmedById String?
  refundedAt  DateTime?
  refundId    String?
  refundError String?
  createdAt   DateTime  @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  REFUNDED
  REFUND_FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

model Coupon {
  id            String     @id @default(uuid())
  code          String     @unique
  type          CouponType
  /// PERCENT: 1-100. FIXED: centavos.
  value         Int
  minOrderCents Int        @default(0)
  maxUses       Int?
  usedCount     Int        @default(0)
  expiresAt     DateTime?
  active        Boolean    @default(true)
  createdAt     DateTime   @default(now())
}

model OrderEvent {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  from      OrderStatus?
  to        OrderStatus
  createdAt DateTime    @default(now())
}

/// Tokens de sessão encerrados no logout. A linha some depois que o token expiraria de qualquer jeito.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}

/// Trilha de auditoria: quem fez o quê e quando. Nunca guarda senhas, tokens nem dados de clientes.
model AuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actorId    String?
  /// Cópia do e-mail no momento da ação (continua legível mesmo se o usuário for alterado depois).
  actorEmail String?
  action     String
  entity     String?
  entityId   String?
  meta       Json?
  ip         String?

  @@index([at])
  @@index([action])
}
