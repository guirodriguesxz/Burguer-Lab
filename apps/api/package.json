    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "^6.19.3",
    "@sentry/node": "^11.8.0",
    "bcryptjs": "^3.0.3",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
