# Copie para .env e preencha. Gere segredos com:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
PIX_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
# Pix real via Mercado Pago (opcional). Sem PIX_PROVIDER o sistema usa o simulador.
# Painel do Mercado Pago > Suas integrações: access token e, em Webhooks, a URL
# https://seudominio.com/api/webhooks/mercadopago (evento: Pagamentos) e o segredo gerado.
PIX_PROVIDER=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_API_URL=https://seudominio.com
# Opcional: usuários da cozinha e do caixa
CASHIER_EMAIL=
CASHIER_PASSWORD=
KITCHEN_EMAIL=
KITCHEN_PASSWORD=
# Modo demonstração (portfólio): Pix de teste liberado e contas de teste no login. Deixe vazio em produção real.
DEMO_MODE=
DEMO_LOGINS=
# Faz o seed (cardápio + usuários) ao iniciar. Idempotente: só cria o que falta e NÃO sobrescreve
# senhas de usuários existentes (uma senha redefinida pelo próprio usuário continua valendo).
SEED_ON_BOOT=true

# Endereço público do app da equipe (usado no link do e-mail de redefinição de senha)
ADMIN_URL=https://seudominio.com/admin/
# Opcional: e-mail real via Resend (https://resend.com). Sem isso, o link aparece só no log da aplicação.
RESEND_API_KEY=
MAIL_FROM=Burger Lab <no-reply@seudominio.com>
