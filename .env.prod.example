# Copie para .env e preencha. Gere segredos com:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
PIX_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
# Opcional: usuário da cozinha
KITCHEN_EMAIL=
KITCHEN_PASSWORD=
# Faz o seed (cardápio + usuários) ao iniciar. Idempotente; redefine a senha do admin para o valor acima.
SEED_ON_BOOT=true
